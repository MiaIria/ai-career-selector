# =====================================================================
# 数据库（Neon PostgreSQL）
# - DATABASE_URL：运行时连接串，使用 Neon 的 Pooled 连接（PgBouncer 兼容）
# - DIRECT_URL：仅给 Prisma CLI（migrate）使用的直连串
#   Neon 控制台 → Connection Details → "Pooled connection" 与 "Direct connection" 分别复制
# =====================================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# =====================================================================
# MiniMax（请复制为 .env.local 后填写，禁止提交真实密钥）
# 不配置时，路径推演会自动回退到内置规则引擎
# =====================================================================
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimaxi.com/v1"
MINIMAX_MODEL="minimax-m3"

# 会话签名，至少32位随机字符串（Vercel 用 `openssl rand -hex 32` 生成）
SESSION_SECRET=""
